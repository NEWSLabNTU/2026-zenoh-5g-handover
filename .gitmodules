[submodule "zenoh"]
	path = zenoh
	url = https://github.com/jerry73204/zenoh.git
	# build_experiments.sh checks out branches inside zenoh/ and leaves gigabytes
	# of target/ artifacts there, which would make `git status` permanently noisy.
	# `dirty` suppresses that while still reporting commit moves, so an intentional
	# pin update stays visible. Do NOT use `all` -- that would hide the pin itself.
	ignore = dirty
